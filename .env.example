# Copy this file to .env.local and fill in values as they become available.
# .env.local is gitignored — never commit real secrets.

# Supabase — connects real data instead of sample data (see README "Setting up Supabase")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed to run `npm run import:supabase` (one-time seed import) — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# AI credentials — enables real AI-generated content instead of stub drafts.
# Set ONE of these; the gateway key wins if both are present.
#   AI_GATEWAY_API_KEY — routes Claude calls through Vercel's AI Gateway
#     (key starts with `vck_`; create it at Vercel > AI Gateway > API Keys),
#     so spend and traffic show up in the Vercel dashboard.
#   ANTHROPIC_API_KEY  — calls the Anthropic API directly (key starts with
#     `sk-ant-`; create it in the Anthropic Console).
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the model used for content drafting (defaults to
# claude-opus-5). Write it bare ("claude-opus-5") or gateway-style
# ("anthropic/claude-opus-5") — the prefix is added or stripped to match
# whichever route is in use.
EO_TRACKER_MODEL=
# Optional: override the model used to summarize/classify Federal Register
# documents (defaults to claude-fable-5).
EO_TRACKER_SUMMARY_MODEL=

# Optional: gates the whole app behind a single shared password (see README
# "Interim access before real auth"). Leave unset for local development —
# this is a temporary stand-in for Phase 5 auth, not a real accounts system.
SITE_PASSWORD=

# Required in production once /api/cron/* is scheduled (see README "Federal
# Register ingestion") — a long random value Vercel Cron sends back as a
# Bearer token, so those endpoints can tell a real scheduled invocation from
# an arbitrary request. Generate one yourself (e.g. `openssl rand -hex 32`)
# and set it in both .env.local and the Vercel project's env vars.
CRON_SECRET=
