# Copy this file to .env.local and fill in values as they become available.
# .env.local is gitignored — never commit real secrets.

# Supabase — connects real data instead of sample data (see README "Setting up Supabase")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed to run `npm run import:supabase` (one-time seed import) — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — enables real AI-generated content instead of stub drafts
ANTHROPIC_API_KEY=
# Optional: override the model used for content generation (defaults to claude-opus-5)
EO_TRACKER_MODEL=

# Optional: gates the whole app behind a single shared password (see README
# "Interim access before real auth"). Leave unset for local development —
# this is a temporary stand-in for Phase 5 auth, not a real accounts system.
SITE_PASSWORD=

# Required in production once /api/cron/* is scheduled (see README "Federal
# Register ingestion") — a long random value Vercel Cron sends back as a
# Bearer token, so those endpoints can tell a real scheduled invocation from
# an arbitrary request. Generate one yourself (e.g. `openssl rand -hex 32`)
# and set it in both .env.local and the Vercel project's env vars.
CRON_SECRET=
